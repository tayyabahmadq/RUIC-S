# Dependencies
node_modules/

# Build output
dist/
out/
dist-exe/

# Run artifacts — any depth (engine and deck journals recreate on demand)
**/OUTPUT/
**/COMMONS/DELTA/
**/COMMONS/STATE/
**/COMMONS/WORKSPACE/
**/COMMONS/ARCHIVE/
**/COMMONS/BRIEF.md

# Verification harness runtime (regenerated by tools/verify/make_harness.sh)
tools/verify/.harness/

# Secrets — never publish
keystores/
.env
.env.*

# Logs & OS junk
*.log
.DS_Store
Thumbs.db
.shots/
# Electron crash core dumps (left by gate runs in headless sandboxes)
core
core.*
# Governance journal — a tracked .log; the negation MUST stay AFTER the
# blanket *.log rule above or git ignores the file.
!opus-deck-software/DECISIONS.log

# Packaging
*.zip
