{
  "name": "ruic-app",
  "version": "1.0.0",
  "private": true,
  "description": "Ruic Control Deck - Electron (Chromium) desktop shell around the frozen ruic engine.",
  "main": "dist/main/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test dist/test/*.test.js",
    "test:electron": "node scripts/build.mjs && node scripts/run-electron-contract.mjs",
    "probe": "node scripts/probe-bridge-types.mjs",
    "gate": "node scripts/gate.mjs",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "electron": "^31.7.7",
    "electron-builder": "^26.18.0",
    "typescript": "^5.5.0"
  },
  "build": {
    "appId": "com.ruic.deck",
    "productName": "Ruic",
    "files": [
      "dist/**/*"
    ],
    "directories": {
      "output": "dist-exe"
    },
    "extraResources": [
      {
        "from": "../opus-deck-software",
        "to": "engine",
        "filter": [
          "dist/**/*",
          "package.json"
        ]
      },
      {
        "from": "../opus-deck-software/node_modules/zod",
        "to": "engine/node_modules/zod",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Ruic.exe"
    }
  }
}